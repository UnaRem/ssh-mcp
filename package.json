{
  "name": "ssh-mcp",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "SSH/SFTP MCP 工具：面向 agent 的快速、可判定的远端执行与传输",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "lint": "bunx tsc --noEmit",
    "live": "bun run scripts/live-verify.ts",
    "build": "bun build --compile src/index.ts --outfile dist/ssh-mcp.exe",
    "dist-verify": "bun run scripts/dist-verify.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ssh-config": "^5.3.0",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.6",
    "bun-types": "^1.4.4"
  }
}
